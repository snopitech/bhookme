# ============================================
# bhookme — .gitignore
# ============================================

# Environment files (contains secrets — NEVER commit)
.env
.env.local
.env.*.local
**/.env
**/.env.local

# Java / Maven
target/
*.class
*.jar
*.war
*.ear

# Node / Vite
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Cloudflare / build output
.turbo/
.next/
out/
# Dump files - scraper / dev artifacts, not repo material
*-dump.txt

# SQL dumps - may contain real user data
*.sql

# Accidental empty files from pasting into the wrong window
